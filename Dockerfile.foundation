# Foundation(외부/워크스테이션) 이미지 — 실제 시험의 "외부 터미널"
# 여기서 시작해서  ssh greg@control  (또는 ssh greg@control) 로 내부에 접속한다.
FROM rhce-lab-base:latest

# 외부 터미널 콘솔은 greg 으로 로그인 (control 로 무암호 ssh 가능)
RUN sed -i 's#/bin/bash -l#/bin/su - greg#' /etc/systemd/system/ttyd.service

RUN printf '%s\n' \
    '=================== RHCE v9 외부 터미널 (foundation) ===================' \
    ' 실제 시험처럼 여기서 control node 로 접속해 작업을 시작하세요:' \
    '' \
    '     ssh greg@control            (비밀번호 없이 접속됨)' \
    '' \
    ' 접속 후 /home/greg/ansible 을 만들고 문제를 풉니다.' \
    ' 관리노드로도 직접 갈 수 있습니다:  ssh greg@node1 ...' \
    '=====================================================================' \
    > /etc/motd

CMD ["/sbin/init"]
